module fsm_write_memory(
    input logic inclk,
    input logic start,
    output logic [7:0] counter_value,
    output logic [7:0] address,
    output logic finish,
    output logic [7:0] check_state,
    //output logic wm_sh_ack,
    //input logic sh_wm_ack,
    output logic control_transfer,
    output logic write_enable
);

logic [7:0] counter_i   = 8'b0;
logic [7:0] state       = 8'b00000000;

parameter s_start       = 8'b00000000;
parameter s_hold        = 8'b00010000;
parameter s_write       = 8'b00100001;
parameter s_increment   = 8'b00110000;
parameter s_finish      = 8'b01000010;
parameter s_reply_ack   = 8'b01010110;
parameter s_sync_1      = 8'b01100010;
parameter s_sync_2      = 8'b01110010;

assign write_enable     = state[0];
assign finish           = state[1];
assign counter_value    = counter_i;
assign address          = counter_i;
assign wm_sh_ack        = state[2];


always_ff @(posedge inclk) begin
        case (state)
            s_start: begin
                control_transfer <= 1'b1;
                check_state <= s_start;
                if(start) begin
                    state <= s_hold;
                end else begin
                    state <= s_start;
                end
            end
            s_hold: begin
                control_transfer <= 1'b1;
                check_state <= s_hold;
                state <= s_write;
            end
            s_write: begin
                control_transfer <= 1'b1;
                check_state <= s_write;
                state <= s_increment;
            end
            s_increment: begin
                control_transfer <= 1'b1;
                check_state <= s_increment;
                if(counter_i == 8'b11111111) begin
                    state <= s_finish;
                end else begin
                    state <= s_hold;
                end
            end
            s_finish: begin
                check_state <= s_finish;
                control_transfer <= 1'b0;
                if(!sh_wm_ack) begin
                    state <= s_finish;   // I change here 
                end else begin
                    state <= s_finish;
                end
            end
            /*
            s_sync_1: begin
                check_state <= s_sync_1;
                state <= s_sync_2;
            end
            s_sync_2: begin
                check_state <= s_sync_2;
                state <= s_reply_ack;
            end
            s_reply_ack: begin
                check_state <= s_reply_ack;
                state <= s_start;
            end
            */
            default: begin
                check_state <= 8'b11111111;
                state <= s_start;
            end
        endcase
    end

always_ff @(posedge inclk) begin
    if(state == s_increment) begin
        counter_i <= counter_i + 8'b00000001;
    end else if (state == s_finish) begin
        counter_i <= 8'b0;
    end else begin
        counter_i <= counter_i;
    end
end

endmodule