        s_hold: begin
            //wren <= 0;
            //send_addr <= counter_i;
            if(reset) begin
                data_j_reg <= 8'b0;
            end else begin
            addr_j_reg <= addr_j_reg + data_i_reg + data_sk;
            end
        end
        s_send_i: begin
            //wren <= 0;
            send_addr <= counter_i;
        end
        s_get_i: begin
            //wren <= 0;
